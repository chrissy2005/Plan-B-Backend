type Query {
    myProjects: [ProjectSummary!]!
    project(projectId: ID!): ProjectDetails
}

type ProjectSummary {
    projectId: ID!
    name: String!
    status: ProjectStatus!
    role: ProjectRole!
}

type ProjectDetails {
    projectId: ID!
    name: String!
    description: String
    status: ProjectStatus!
    role: ProjectRole!
    createdByUserFirstName: String
    createdByUserLastName: String
    members: [ProjectMember!]!
    meetings: [ProjectMeeting!]!
    longToDos: [ProjectLongToDo!]!
}

type ProjectMember {
    userId: ID!
    firstName: String
    lastName: String
    email: String
    role: ProjectRole!
}

type ProjectMeeting {
    meetingId: ID!
    title: String!
    description: String
    startDateTime: String
    endDateTime: String
    done: Boolean!
    participantIds: [ID!]!
}

type ProjectLongToDo {
    longToDoId: ID!
    title: String!
    description: String
    priority: TaskPriority
    startDateTime: String
    endDateTime: String
    done: Boolean!
    assignedMemberIds: [ID!]!
    subtasks: [ProjectSubtask!]!
}

type ProjectSubtask {
    subtaskId: ID!
    title: String!
    description: String
    done: Boolean!
    assigneeId: ID
    priority: TaskPriority
}

enum ProjectStatus {
    ACTIVE
    COMPLETED
}

enum ProjectRole {
    MEMBER
    PROJECT_LEADER
}

enum TaskPriority {
    HIGH
    MEDIUM
    LOW
}

type Mutation {
    createMeeting(
        projectId: ID!
        input: CreateMeetingInput!
    ): CreateMeetingPayload!

    createLongToDo(
        projectId: ID!
        input: CreateLongToDoInput!
    ): CreateLongToDoPayload!
}

input CreateMeetingInput {
    title: String!
    description: String
    startDateTime: String!
    endDateTime: String!
    participantIds: [ID!]!
}

input CreateLongToDoInput {
    title: String!
    description: String
    startDateTime: String!
    endDateTime: String!
    priority: TaskPriority!
    assignedMemberIds: [ID!]!
    subtasks: [CreateSubtaskInput!]
}

input CreateSubtaskInput {
    title: String!
    description: String
    priority: TaskPriority! = MEDIUM
}

type CreateMeetingPayload {
    meetingId: ID!
    message: String!
}

type CreateLongToDoPayload {
    longToDoId: ID!
    message: String!
}